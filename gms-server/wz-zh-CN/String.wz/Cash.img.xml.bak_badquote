  <imgdir name="5152210">
    <string name="name" value="天天变整容券"/>
    <string name="desc" value="在#c天空之城整形手术医院的塑料罗伊#处使用，就能拥有1次重塑脸型的机会。且脸型将变更为#c天天变#脸型，周一到周日每天都不相同，每天都会给你带来新的惊喜！\n在更换为其他脸型之前将永久应用。"/>
  </imgdir>
