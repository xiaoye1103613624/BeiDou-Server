  <imgdir name="5502000">
    <string name="name" value="Lv.5防具解放的钥匙"/>
    <string name="desc" value="将#c解放的钥匙#拖动到装备窗口（#c快捷键E#）中的目标栏中，就能在30天内装备比自己的等级高出#c5级#的防具。不能与\n#c其他等级的解放的钥匙#叠加使用。拥有#c女皇的强化#技能的角色将无法使用解放的钥匙。\n#c可使用的装备栏：帽子，肩饰，上衣，裤裙，长袍，披风，手套，腰带，鞋子#"/>
  </imgdir>
  <imgdir name="5502001">
    <string name="name" value="Lv.5武器解放的钥匙"/>
    <string name="desc" value="将#c解放的钥匙#拖动到装备窗口（#c快捷键E#）中的目标栏中，就能在30天内装备比自己的等级高出#c5级#的武器。不能与\n#c其他等级的解放的钥匙#叠加使用。拥有#c女皇的强化#技能的角色将无法使用解放的钥匙。不能使用于无法佩戴/解除的道具。\n#c可使用的装备栏：武器，盾牌，辅助武器#"/>
  </imgdir>
  <imgdir name="5502002">
    <string name="name" value="Lv.5饰品解放的钥匙"/>
