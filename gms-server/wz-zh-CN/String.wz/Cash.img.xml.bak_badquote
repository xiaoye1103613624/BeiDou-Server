  <imgdir name="5681002">
    <string name="name" value="[BLACKPINK] BLACK稱號交換券"/>
    <string name="desc" value="#c雙擊#使用時，可以獲得#cBLACK#稱號(永久、屬性套用時間：60天)，獲得的稱號不可交易。"/>
    <string name="desc_leftalign" value="#c [BLACK 稱號屬性]\n 追加經驗值 10%\n 攻擊力/魔力+15\n 全屬性 +15\n BOSS怪物攻擊時傷害+10%\n 無視防禦率+10%\n 最大HP/最大MP+750\n 星力 +30\n 神秘力量 +50\n 屬性套用時間: 60天"/>
  </imgdir>
  <imgdir name="5681003">
    <string name="name" value="[BLACKPINK] PINK稱號交換券"/>
    <string name="desc" value="#c雙擊#使用時，可以獲得#cPINK#稱號(永久、屬性套用時間：60天)，獲得的稱號不可交易。"/>
    <string name="desc_leftalign" value="#c [PINK 稱號屬性]\n 追加經驗值 10%\n 攻擊力/魔力+15\n 全屬性 +15\n BOSS怪物攻擊時傷害+10%\n 無視防禦率+10%\n 最大HP/最大MP+750\n 星力 +30\n 神秘力量 +50\n 屬性套用時間: 60天"/>
  </imgdir>
