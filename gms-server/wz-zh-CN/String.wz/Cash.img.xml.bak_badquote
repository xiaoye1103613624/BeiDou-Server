  <imgdir name="5220082">
    <string name="name" value="驚奇騎寵轉蛋"/>
    <string name="desc" value="帶著該票券給#c弓箭手村市場的歐思特#的話，就會隨機獲得1種騎乘技能的票券。"/>
  </imgdir>
  <imgdir name="5222006">
    <string name="name" value="神奇服飾箱"/>
    <string name="desc" value="雙擊之後，可以隨機獲得一樣現金裝飾道具，且部分道具將有神奇的能力。"/>
  </imgdir>
  <imgdir name="5222117">
    <string name="name" value="初音未來外觀裝備箱子"/>
    <string name="desc" value="會隨機出現一個外觀裝備的箱子。購入後在特殊欄位點擊即可開封。\n#c從箱子中得到但卻不需要的外觀裝備拿給活動導遊的話，就能夠交換回收優惠卷。#\n#c此外，活動期間中也可以交換初音未來印章。#\n#c道具的抽選會由系統進行，並非一定能得到稀有道具，抽選的機率也不會根據購買次數而產生變動。#\n(c)CFM"/>
  </imgdir>
  <imgdir name="5222123">
    <string name="name" value="時尚隨機箱"/>
    <string name="desc" value="使用後可以隨機取得1個#c特殊外觀服裝#或是#c實用的付費道具#"/>
  </imgdir>
  <imgdir name="5222138">
    <string name="name" value="寵物隨機箱"/>
    <string name="desc" value="可以在各種寵物中，隨機獲得一種寵物的隨機箱，而透過寵物隨機箱獲得的寵物可以使用寵物硬幣來交換。"/>
  </imgdir>
  <imgdir name="5222170">
    <string name="name" value="Re:從零開始的異世界生活服飾隨機箱"/>
    <string name="desc" value="隨機會提供 Re:從零開始的異世界生活服飾的箱子。"/>
  </imgdir>
  <imgdir name="5223000">
    <string name="name" value="神奇卷軸箱"/>
    <string name="desc" value="雙擊之後，有三次機會讓你選擇，每一次機會都會隨機抽出一張，你可選擇想要擁有的卷軸唷。"/>
  </imgdir>
  <imgdir name="5240097">
    <string name="name" value="紅色火花"/>
    <string name="desc" value="#c白色蠟燭#喜歡的火花。 可以全部恢復飽腹感並可以提升#c親密度100#"/>
  </imgdir>
  <imgdir name="5240098">
    <string name="name" value="黃色火花"/>
    <string name="desc" value="#c藍色蠟燭#喜歡的火花。 可以全部恢復飽腹感並可以提升#c親密度100#"/>
  </imgdir>
  <imgdir name="5240099">
    <string name="name" value="藍色火花"/>
    <string name="desc" value="#c粉紅蠟燭#喜歡的火花。 可以全部恢復飽腹感並可以提升#c親密度100#"/>
  </imgdir>
  <imgdir name="5240116">
    <string name="name" value="油"/>
    <string name="desc" value="可讓撒嬌弟弟#c炸蝦B#更脆的麵包粉，恢復整體的飽足感，提高#c親密度100#。"/>
  </imgdir>
  <imgdir name="5240132">
    <string name="name" value="牛奶好朋友"/>
    <string name="desc" value="只有#c黑眼圈艾爾文、喵咪莉莉、小貓咪奈洛、奈蘿喵、起司喵、三順喵#才能喝的新鮮牛奶。會恢復所有飽滿感，且 #c提升親密度 100#。"/>
  </imgdir>
  <imgdir name="5240133">
    <string name="name" value="馬卡龍糖果"/>
    <string name="desc" value="只有#c草莓馬卡龍熊、香蕉馬卡龍熊、餅乾馬卡龍熊#才能吃的甜蜜糖果。恢復所有飽足感後，#c提升親密度100 #。"/>
  </imgdir>
  <imgdir name="5240134">
    <string name="name" value="王子的珍珠"/>
    <string name="desc" value="只有#c海豹王子#們才能吃的甘味雪糖。會恢復所有飽滿感，且#c提升親密度100點#。"/>
  </imgdir>
  <imgdir name="5240135">
    <string name="name" value="小黃鴨的可口果汁"/>
    <string name="desc" value="只有從楓之谷2來的 #c小黃鴨#能喝的美味果汁。會恢復所有飽滿感，且#c提升親密度100點#。"/>
  </imgdir>
  <imgdir name="5240137">
    <string name="name" value="秘密的甜點味道"/>
    <string name="desc" value="只能吃#c滑潤蛋糕、西點派、甜美糖果#而已。吃下超級無敵甜點味道的魔法飼料來恢復所有飽滿感，且#c親密度提升100#。"/>
  </imgdir>
  <imgdir name="5240138">
    <string name="name" value="火焰之眼糖果"/>
    <string name="desc" value="只有#c小殘暴炎魔#能吞下的奇妙糖果'火焰之眼'。會恢復所有飽滿感，且#c親密度 提升100#。"/>
  </imgdir>
  <imgdir name="5240140">
    <string name="name" value="英雄糧食"/>
    <string name="desc" value="#c小龍魔導士、小狂狼勇士、小幻影、小夜光、小精靈遊俠、小隱月#才能吃的英雄糧食。將飽滿感全部恢復，#c親密度上升100 #。"/>
  </imgdir>
  <imgdir name="5240141">
    <string name="name" value="鑽石糖"/>
    <string name="desc" value="#c小戴米安、小愛麗西亞、小莉琳#才能吃的鑽石糖。魔族軍隊都會確實提供用餐。將飽滿感全部恢復，#c親密度上升100 #。"/>
  </imgdir>
  <imgdir name="5240142">
    <string name="name" value="棉花糖糖果"/>
    <string name="desc" value="只能吃#c雲/綠色/粉紅色棉花糖#的棉花糖糖果。 恢復飽足感，也#c提高親密度 100#。"/>
  </imgdir>
