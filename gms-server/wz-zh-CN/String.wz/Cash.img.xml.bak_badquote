  <imgdir name="5240131">
    <string name="name" value="귤귤이 물방울"/>
    <string name="desc" value="#c귤귤이#만 먹을 수 있는 시원한 물방울이다. 포만감을 모두 회복시켜주고 #c친밀도를 100 상승#시켜준다."/>
  </imgdir>
  <imgdir name="5249000">
    <string name="name" value="万能宠物食物"/>
    <string name="desc" value="所有宠物都可以吃的万能宠物食物，并提高#c 100 亲密度#。"/>
  </imgdir>
  <imgdir name="5250002">
    <string name="name" value="逆奥之流"/>
    <string name="desc" value="探险逆奥之城所需的道具. 若持有该道具,阿夕亚便会许可前往逆奥地区."/>
  </imgdir>
  <imgdir name="5250003">
    <string name="name" value="清明节护肩交换券"/>
    <string name="desc" value="和一种假皮护肩一起交给假面绅士，可交换到其他属性的假皮护肩。\n兑换时间：3/28-4/17"/>
  </imgdir>
  <imgdir name="5250004">
    <string name="name" value="失恋33次"/>
    <string name="desc" value="告白的失败也可以是试探内心真正心爱的人的考验，很多次失败以后迎来的成功更加灿烂！\n白色情人节活动专用消耗道具：带本道具表白会导致失败，#c消耗1个道具增加1次失败次数#，能不能坚持到最后迎来成功呢？\n失恋#c33次#之后等待的是？！"/>
  </imgdir>
  <imgdir name="5250006">
    <string name="name" value="进化指环高级研磨剂"/>
    <string name="desc" value="进化指环升级至8阶段以上时需要使用的高级研磨剂。#c绝对指环活动结束后无法继续使用。#"/>
  </imgdir>
  <imgdir name="5250500">
    <string name="name" value="House 婚礼券"/>
    <string name="desc" value="在小礼堂里可以举行简单婚礼的门票。在New 婚礼公园#c双击#即可进行求婚。结婚之后新郎新娘可以获得#c永恒婚戒#。\r\n*주의: #c神之子#无法使用。"/>
  </imgdir>
  <imgdir name="5251007">
    <string name="name" value="奇异的羽毛"/>
    <string name="desc" value="与2010爱老虎哟有关，奇怪的羽毛，究竟有什么特别的作用？拥有时好像可以获得另外补偿。"/>
  </imgdir>
  <imgdir name="5251010">
    <string name="name" value="行动卡"/>
    <string name="desc" value="#c劳动最光荣#活动道具.拿给冒险岛运营员NPC,即可为本服务器累计#c20积分#."/>
  </imgdir>
  <imgdir name="5251016">
    <string name="name" value="서약식 티켓"/>
    <string name="desc" value="30일 서약식, 100일 서약식을 진행하기 위해 필요한 티켓이다."/>
  </imgdir>
  <imgdir name="5252004">
    <string name="name" value="马来西亚boss地图入场券"/>
    <string name="desc" value="可让你进入马来西亚boss地图的入场券。"/>
  </imgdir>
  <imgdir name="5252006">
    <string name="name" value="绯红组队任务念力钥匙"/>
    <string name="desc" value="绯红要塞组队任务入场所需的钥匙."/>
  </imgdir>
  <imgdir name="5252009">
    <string name="name" value="旅行纪念票"/>
    <string name="desc" value="为旅行者准备的VIP票. 持有此物品情况下，旅行完毕能获得2个纪念周画.\r\n#c追加的是海豚，获得纪念周画的概率会提高.#"/>
  </imgdir>
  <imgdir name="5252014">
    <string name="name" value="头目怪物公园大门喇叭(1次)"/>
    <string name="desc" value="激活大师冒险公园大门，打开进入怪物巢穴的传送口。"/>
  </imgdir>
  <imgdir name="5252016">
    <string name="name" value="班·雷昂联盟活动券"/>
    <string name="desc" value="一张在活动期间用于进入独眼巨人副本的入场券。通过NPC进入副本后，活动券就会消失。"/>
  </imgdir>
  <imgdir name="5252017">
    <string name="name" value="枫之高校通行钥匙"/>
    <string name="desc" value="可以打开枫之高校右边门的锁，开始一次不可思议的巡视教室之旅。\n注：只要探险一开始，就会消耗一把钥匙"/>
  </imgdir>
  <imgdir name="5252019">
    <string name="name" value="黑暗盒子4的高级钥匙"/>
    <string name="desc" value="用于打开黑暗盒子4的钥匙。似乎可以拿到比用旧钥匙时更好的道具。"/>
  </imgdir>
  <imgdir name="5252022">
    <string name="name" value="怪物竞技场入场券"/>
    <string name="desc" value="可以进入怪物竞技场1次的入场券。进入怪物竞技场时，入场券自动消失。"/>
  </imgdir>
  <imgdir name="5252023">
    <string name="name" value="怪物竞技场组队入场券"/>
    <string name="desc" value="队长持有时，可以和队员们一起进入怪物竞技场1次。进入怪物竞技场时，入场券自动消失。"/>
  </imgdir>
  <imgdir name="5252025">
    <string name="name" value="枫之高校特别授课钥匙"/>
    <string name="desc" value="接受可随时进入的枫之高校特别授课。"/>
  </imgdir>
  <imgdir name="5252028">
    <string name="name" value="游戏币"/>
    <string name="desc" value="游戏机专用钱币，如果放入游戏机，就能进行游戏。"/>
  </imgdir>
  <imgdir name="5253000">
    <string name="name" value="月饼帽兑换券（7天权）"/>
    <string name="desc" value="跟#c星缘#对话，可以兑换月饼帽(7天权)。一个角色总共只能使用一次月饼帽兑换券。"/>
  </imgdir>
  <imgdir name="5253001">
    <string name="name" value="药水兑换券1"/>
    <string name="desc" value="跟#c浪漫#对话，可以兑换药水。"/>
  </imgdir>
  <imgdir name="5253002">
    <string name="name" value="药水兑换券2"/>
    <string name="desc" value="跟#c浪漫#对话，可以兑换药水。"/>
  </imgdir>
  <imgdir name="5253003">
    <string name="name" value="药水兑换券3"/>
    <string name="desc" value="跟#c浪漫#对话，可以兑换药水。"/>
  </imgdir>
  <imgdir name="5253004">
    <string name="name" value="药水兑换券4"/>
    <string name="desc" value="跟#c浪漫#对话，可以兑换药水。"/>
  </imgdir>
