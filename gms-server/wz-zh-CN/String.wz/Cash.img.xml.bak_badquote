    <string name="name" value="和谢拉共享下午茶"/>
    <string name="desc" value="可以与谢拉王子共享下午茶的椅子。每10秒恢复HP 100, MP 50。"/>
  </imgdir>
  <imgdir name="5204001">
    <string name="name" value="和克里姆共享下午茶"/>
    <string name="desc" value="可以与女仆克里姆共享甜美下午茶的椅子。每10秒恢复HP 100, MP 50。"/>
  </imgdir>
