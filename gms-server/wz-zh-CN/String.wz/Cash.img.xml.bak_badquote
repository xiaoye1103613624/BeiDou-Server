  <imgdir name="5680348">
    <string name="name" value="格利佛特效交换券"/>
    <string name="desc" value="巨人都是相对的！虽在冒险岛里是二头身，但小人国中我是巨人！！用格利佛特效炫出你的巨大化身躯。"/>
  </imgdir>
  <imgdir name="5680350">
    <string name="name" value="彩虹小马马厩"/>
    <string name="desc" value="#c双击#并回答问题。根据你回答的不同，你会获得不同属性的#c神秘的彩虹小马宠物#。"/>
  </imgdir>
  <imgdir name="5680351">
    <string name="name" value="格利佛特效交换券(30天）"/>
    <string name="desc" value="巨人都是相对的！虽在冒险岛里是二头身，但小人国中我是巨人！！用格利佛特效炫出你的巨大化身躯。"/>
  </imgdir>
  <imgdir name="5680363">
    <string name="name" value="记忆中的大餐交换券"/>
    <string name="desc" value="记忆中的大餐效果交换券 \n#c双击#，就能得到“记忆中的大餐”效果。
童年记忆中的盛宴。双击图标或菜单上的某些键设置快捷键指定快捷键按下后ON / OFF。"/>
  </imgdir>
  <imgdir name="5680422">
    <string name="name" value="三倍爆率卡"/>
    <string name="desc" value="拥有该道具,可获得#c3倍怪物爆率#.获得该道具后换线生效"/>
  </imgdir>
  <imgdir name="5680428">
