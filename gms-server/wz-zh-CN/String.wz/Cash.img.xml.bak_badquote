    <string name="desc_leftalign" value="#c [BLACK 勳章屬性]\n STR : +6\n DEX : +6\n INT : +6\n LUK : +6\n 最大HP : +808\n 最大MP : +808\n 攻擊力 : +3\n 魔力 : +3\n 防禦力 : +808"/>
  </imgdir>
