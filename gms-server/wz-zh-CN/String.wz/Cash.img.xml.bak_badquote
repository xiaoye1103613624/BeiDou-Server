  <imgdir name="5021000">
    <string name="name" value="水弹"/>
    <string name="desc" value="给人清爽感觉的水球。装配在#c飞镖# 上，当使用标枪时便会出现丢水球的 特效。飞镖类道具无法抵当给系统。"/>
