  <imgdir name="5040000">
    <string name="name" value="缩地石"/>
    <string name="desc" value="记忆5个特定地图后可以随时移动 到该地图。游戏区和频道一样的话可 以移动到有特定玩家的地方。"/>
  </imgdir>
  <imgdir name="5040001">
    <string name="name" value="可乐翅膀"/>
    <string name="desc" value="喝下爽口的#c可口可乐#便可#c移动到所 记录的地图#。在相同频道内，可移动到#c 特定角色所在的地图#。无法前往限制移 动的地图或是不同大陆的地图。"/>
  </imgdir>
  <imgdir name="5041000">
    <string name="name" value="高级瞬移之石"/>
    <string name="desc" value="可在#c岛屿间进行传送的石头#。在相同 频道内，可移动到特定角色所在的地 图。最多可记录#c10个#地图。无法前往 限制移动的地图。"/>
  </imgdir>
  <imgdir name="5050000">
    <string name="name" value="洗能力点卷轴"/>
    <string name="desc" value="可以洗已使用过的能力点的卷轴。 把在HP，MP，力量，敏捷，智力。运 气加上的能力点可以回到加上别的能 力值。"/>
  </imgdir>
  <imgdir name="5050001">
    <string name="name" value="技能点重置卷(1转)"/>
    <string name="desc" value="把1转技能使用过的技能点洗后加 在别的1转技能上。"/>
  </imgdir>
  <imgdir name="5050002">
    <string name="name" value="技能点重置卷(2转)"/>
    <string name="desc" value="把2转技能使用过的技能点洗后加 在别的2转技能上。而且如果把2转以 后得到技能点加在1转技能上使用， 那些技能点也可以洗。"/>
  </imgdir>
  <imgdir name="5050003">
    <string name="name" value="技能点重置卷(3转)"/>
    <string name="desc" value="把3转技能使用过的技能点洗后加 在别的3转技能上。而且如果把3转以 后得到技能点加在2转或1转技能上使 用，那些技能点也可以洗。"/>
  </imgdir>
  <imgdir name="5050004">
    <string name="name" value="技能点重置卷(4转)"/>
    <string name="desc" value="把4转技能使用过的技能点洗后加 在别的4转技能上。而且如果把4转以 后得到技能点加在其他技能上使用， 那些技能点也可以洗。"/>
  </imgdir>
  <imgdir name="5060000">
    <string name="name" value="道具取名"/>
