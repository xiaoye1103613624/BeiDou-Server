  </imgdir>
  <imgdir name="5042001">
    <string name="name" value="高级瞬移之石"/>
    <string name="desc" value="可在#c岛屿间进行传送的石头#。在相同频道内，可移动到特定角色所在的地图。最多可记录#c10个#地图。无法前往限制移动的地图。"/>
  </imgdir>
  <imgdir name="5043000">
