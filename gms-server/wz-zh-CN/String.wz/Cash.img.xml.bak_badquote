    <string name="desc" value="點擊的話，可以交換技能點數初始化卷軸 1張。"/>
  </imgdir>
  <imgdir name="5530129">
    <string name="name" value="狂狼勇士技能母書全套交換券"/>
    <string name="desc" value="滑鼠雙擊的話，就可以拿到狂狼勇士技能母書全套使用券。"/>
  </imgdir>
  <imgdir name="5530130">
