  <imgdir name="5180001">
    <string name="name" value="高级生命水"/>
    <string name="desc" value="从冒险岛世界深处采取的生命之水。#c双击使用#可以给变成娃娃的宠物重新注入活力。不能对没有魔法时间的永恒宠物使用。"/>
  </imgdir>
  <imgdir name="5190010">
    <string name="name" value="宠物自动加BUFF技能"/>
    <string name="desc" value="在技能窗口放入需要的BUFF之后，在宠物装备的时候，宠物会自动使用此技能，部分技能无法使用。"/>
  </imgdir>
  <imgdir name="5190011">
    <string name="name" value="宠物训练技能"/>
    <string name="desc" value="训练宠物，让宠物变成智能宠物。可智能移动到主人身边捡取道具、金币，并可以使用自动喂食功能。\n#c可用于所有宠物，只限于宠物食品# "/>
  </imgdir>
  <imgdir name="5190012">
    <string name="name" value="宠物巨大化技能"/>
    <string name="desc" value="打猎与自己等级对应的怪物，宠物会逐渐变大，达到一定程度时可以施展神秘增益。但增益在最后一次使用后，每5分钟自动使用一次。"/>
  </imgdir>
  <imgdir name="5190013">
    <string name="name" value="打开宠物NPC商店技能"/>
    <string name="desc" value="给选择的宠物添加打开杂货商店技能。可以买进一些用于HP,MP恢复的药水，也可以充电飞镖和子弹。但是，在一些地图上，限制使用。"/>
  </imgdir>
  <imgdir name="5192000">
    <string name="name" value="宠物训练箱"/>
    <string name="desc" value="可赋予宠物特殊buff的强化箱子，宠物放入强化箱后，将会从多样的buff中获得一种能力，若拥有3只同样buff的宠物的话，buff效果会极大化。只能用于普通宠物。"/>
  </imgdir>
  <imgdir name="5193001">
    <string name="name" value="蓝色丝带宠物组合技能"/>
    <string name="desc" value="给没有专用组合效果的宠物赋予宠物组合技能“蓝色丝带组合技能”的效果。有3个宠物时，组合技能效果越强。组合技能效果，在背包中通过ON/OFF进行调节，并根据拥有的宠物数量，技能级别会有所变化。（对已有组合技能的宠物是无法适用。）"/>
  </imgdir>
