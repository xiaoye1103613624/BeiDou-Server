  <imgdir name="5250005">
    <string name="name" value="珠寶工藝券"/>
    <string name="desc" value="隨時都可以啟動T-機器3號之後，混合裝備和礦石。 "/>
  </imgdir>
  <imgdir name="5250501">
    <string name="name" value="室內婚禮卷"/>
    <string name="desc" value="可在小教堂裡進行婚禮的卷。在New婚禮花園裡#c雙擊#卷的話可求婚喔。結婚後新郎和新娘可獲得#c永恆婚禮戒指#。\r\n*注意：#c神之子#無法使用。"/>
  </imgdir>
  <imgdir name="5250502">
    <string name="name" value="室內婚禮卷(西洋式)"/>
    <string name="desc" value="可在西洋式儀式上進行簡單婚禮的卷。在西洋式室內婚禮花園上#c雙擊#卷的話可求婚喔。結婚後新郎和新娘可獲得#c永恆婚禮戒指#。\r\n*注意: #c神之子#無法使用。"/>
  </imgdir>
  <imgdir name="5250503">
    <string name="name" value="室內婚禮卷(日式)"/>
    <string name="desc" value="可在日式儀式上可進行簡單婚禮的卷。在日式室內婚禮花園上#c雙擊#卷的話可求婚喔。結婚後新郎和新娘可獲得 #c永恆婚禮戒指#。\r\n*注意： #c神之子#無法使用。"/>
  </imgdir>
  <imgdir name="5250504">
    <string name="name" value="室內婚禮卷(中式)"/>
    <string name="desc" value="可在中式儀式上進行簡單婚禮的卷。在中式室內婚禮花園上#c雙擊#卷的話可求婚喔。結婚後新郎和新娘可獲得#c永恆婚禮戒指#。\r\n*注意: #c神之子#無法使用。"/>
  </imgdir>
  <imgdir name="5251014">
    <string name="name" value="永恆之戀一般券"/>
    <string name="desc" value="可舉辦一般銀婚式的永恆之戀一般券。 #c新郎、新娘可以各招待10名賓客，並完成結婚後可得到銀婚式一般戒。#使用永恆之戀券，進行銀婚式預約之後，將無法取消預約。"/>
  </imgdir>
  <imgdir name="5251015">
    <string name="name" value="永恆之戀高級券"/>
    <string name="desc" value="可舉辦高級銀婚式的永恆之戀高級券。 #c新郎、新娘可以各招待20名賓客，並可得到婚禮攝影、婚禮派對、銀婚式高級戒與特別的禮物。。#使用永恆之戀券，進行銀婚式預約之後，將無法取消預約。"/>
