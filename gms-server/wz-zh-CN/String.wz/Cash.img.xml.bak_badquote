  </imgdir>
  <imgdir name="5390010">
    <string name="name" value="鬼出没情景喇叭"/>
    <string name="desc" value="使用它可以把你的形象显示在所有频道，伴随你的穿着显示在所有人的屏幕上，并有幽灵背景哦。"/>
  </imgdir>
  <imgdir name="5390011">
    <string name="name" value="钻石VIP专用喇叭"/>
    <string name="desc" value="画面上端随着VIP文字出现角色形象，说出的话所属全区都可收到。"/>
  </imgdir>
  <imgdir name="5390012">
    <string name="name" value="黄金VIP专用喇叭"/>
    <string name="desc" value="画面上端随着VIP文字出现角色形象，说出的话所属全区都可收到。"/>
  </imgdir>
  <imgdir name="5390013">
    <string name="name" value="白银VIP专用喇叭"/>
    <string name="desc" value="画面上端随着VIP文字出现角色形象，说出的话所属全区都可收到。"/>
  </imgdir>
  <imgdir name="5390014">
    <string name="name" value="사실 잘 나가는 메가폰"/>
    <string name="desc" value="잘나가는 당신에게! 캐릭터의 모습과 입력한 말이 월드 전체에 나타난다. "/>
  </imgdir>
  <imgdir name="5390015">
    <string name="name" value="엄청 잘 나가는 메가폰"/>
    <string name="desc" value="엄청 잘나가는 당신에게! 아이템 사용 시 캐릭터의 모습과 입력한 말이 월드 전체에 나타난다. "/>
  </imgdir>
  <imgdir name="5390016">
    <string name="name" value="제일 잘 나가는 메가폰"/>
    <string name="desc" value="최고 제일 잘나가는 당신에게! 캐릭터의 모습과 입력한 말이 월드 전체에 나타난다. "/>
  </imgdir>
  <imgdir name="5390017">
    <string name="name" value="红毯扩音器"/>
    <string name="desc" value="为冒险岛名人的你！您的角色和您输入的对话会显示在整个服务器中。"/>
  </imgdir>
  <imgdir name="5390018">
    <string name="name" value="赤兔马情景喇叭"/>
    <string name="desc" value="骏马的威严，你们体会下！使用后全服务器的人都可以看到夕阳中向前奔跑的赤兔马和你的形象。"/>
  </imgdir>
  <imgdir name="5390019">
    <string name="name" value="新闻主播室情景喇叭"/>
    <string name="desc" value="使用它可以把你的形象显示在所有频道，伴随你的穿着显示在所有人的屏幕上，并有新闻主播的背景哦。"/>
  </imgdir>
  <imgdir name="5390020">
    <string name="name" value="我的演唱会情景喇叭"/>
    <string name="desc" value="使用它可以把你的形象显示在所有频道，伴随你的穿着显示在所有人的屏幕上，并有我的演唱会背景哦。"/>
  </imgdir>
  <imgdir name="5390021">
    <string name="name" value="圣诞鹿虚拟扩音器"/>
    <string name="desc" value="  拥有圣诞鹿专用背景的扩音器。伴随着迈向圣诞夜空的圣诞鹿的步伐，你的呐喊声将被整个世界的人们听到。"/>
  </imgdir>
  <imgdir name="5390022">
    <string name="name" value="追赶小羊的狼情景喇叭"/>
    <string name="desc" value="使用道具时，在羊和狼玩耍的田野背景中，角色和输入的话语会显示在全部服务器中。"/>
  </imgdir>
  <imgdir name="5420008">
    <string name="name" value="VIP服务卡"/>
    <string name="desc" value="持有本卡，可虚拟网吧环境享受福利，#c经验增加、额外金币#，更有特别的#cVIP服务#。详情可询#cNPC大姐大#。一卡在手，待遇不同！"/>
  </imgdir>
  <imgdir name="5420011">
    <string name="name" value="春节小游戏入场次数初始化券"/>
    <string name="desc" value="用完了2014年春节小游戏入场次数时，可以消耗该道具初始化入场次数后重新进入。"/>
  </imgdir>
  <imgdir name="5420012">
    <string name="name" value="春节小游戏奖励加倍券"/>
    <string name="desc" value="完成春节小游戏，领取奖励时，如持有该券可以按照随机倍数获得额外奖励。可以获得1~5倍奖励，获得额外奖励时券会被消耗掉。注：冒险冲冲不适用。"/>
  </imgdir>
  <imgdir name="5431002">
    <string name="name" value="角色卡(70级)"/>
    <string name="desc" value="可生成等级提升到70级的角色(部分职业群无法生成).拥有70级以上的角色时,有空余的角色栏时可以购买.购买后角色生成画面中生成拥有70级升级道具的角色."/>
  </imgdir>
  <imgdir name="5431003">
    <string name="name" value="角色卡(50级)"/>
    <string name="desc" value=" 通过此道具生成的角色（部分职业群无法生成，如骑士团和新职业），可依靠道具快速成长到50级\n50级以上的角色,有空余角色栏时才可以购买.购买后将在角色生成画面生成拥有50级升级道具的角色. \n角色选择画面里,可以看到显示”点击”的透明的角色. \n#c※SP(技能点数)若没有转职就会无法获得，所以使用升级道具时请务必注意# "/>
  </imgdir>
  <imgdir name="5431004">
    <string name="name" value="角色卡(100级)"/>
    <string name="desc" value="通过此道具生成的角色（部分职业群无法生成，如骑士团和新职业），可依靠道具快速成长到100级\n100级以上的角色,有空余角色栏时才可以购买.购买后将在角色生成画面生成拥有100级升级道具的角色. \n角色选择画面里,可以看到显示”点击”的透明的角色. \n#c※SP(技能点数)若没有转职就会无法获得，所以使用升级道具时请务必注意# "/>
  </imgdir>
  <imgdir name="5431005">
    <string name="name" value="角色卡(150级)"/>
    <string name="desc" value="可生成等级提升到150级的角色(部分职业群无法生成，当前版无关闭创建的角色无法创建)。拥有100级以上的角色时，有空余的角色栏时可以购买。购买后角色生成画面中生成拥有150级升级道具的角色。"/>
  </imgdir>
  <imgdir name="5440000">
    <string name="name" value="抵用券兑换道具"/>
    <string name="desc" value="可以用点券购买的，该金额抵用券的兑换包。"/>
  </imgdir>
  <imgdir name="5450001">
    <string name="name" value="金先生直通电话"/>
    <string name="desc" value="可以与仓库保管员金先生通话."/>
  </imgdir>
  <imgdir name="5450003">
    <string name="name" value="新手包裹商人妙妙"/>
    <string name="desc" value="相当于入杂货商店，可恢复一些HP,MP,标。但有些地图上无法使用。"/>
  </imgdir>
  <imgdir name="5450004">
    <string name="name" value="包裹商人妙妙（30天）"/>
    <string name="desc" value="使用时，可以进入#c杂货店#。可以购买部分HP、MP恢复药水，补充标枪、子弹等。可以在所有地图上使用。\n在30天内可以#c无限#使用。"/>
  </imgdir>
  <imgdir name="5450005">
    <string name="name" value="移动仓库（30天）"/>
    <string name="desc" value="可使用远处 #c仓库#。一部分道具可以放到仓库，也可以拿到背包。但是只能在指定的地图使用。\n30日内 #c无限制#使用."/>
  </imgdir>
  <imgdir name="5450006">
    <string name="name" value="[1天]包裹商人妙妙"/>
    <string name="desc" value="使用后有进入#c杂货店#的效果。可以购买部分HP、MP恢复药水及飞镖、子弹。所有地图都能使用。\n1天之内#c不限#使用次数。"/>
  </imgdir>
  <imgdir name="5450007">
    <string name="name" value="[7天]包裹商人妙妙"/>
    <string name="desc" value="使用后有进入#c杂货店#的效果。可以购买部分HP、MP恢复药水及飞镖、子弹。所有地图都能使用。\n7天之内#c不限#使用次数。"/>
  </imgdir>
  <imgdir name="5450008">
    <string name="name" value="[1天]移动仓库王先生"/>
    <string name="desc" value="使用后，可以远距离使用#c仓库#。可以把部分道具放入或者拿出仓库。但在部分地图无法使用该功能。\n1天之内#c不限#使用次数。"/>
  </imgdir>
  <imgdir name="5450009">
    <string name="name" value="[7天]移动仓库王先生"/>
    <string name="desc" value="使用后，可以远距离使用#c仓库#。可以把部分道具放入或者拿出仓库。但在部分地图无法使用该功能。\n7天之内#c不限#使用次数。"/>
  </imgdir>
  <imgdir name="5450010">
    <string name="name" value="猫咪商人奈落"/>
    <string name="desc" value="使用后可获得进入杂货店的效果，可购买猫咪商人奈落专卖的特殊道具和部分HP、MP回复药水，以及飞镖、弹药等。\n可通过奈落购买的专属道具有：#c大幅打折的超级药水、无价之宝椅子、彪鲁纪念币#等。\n每次购买奈落商店的#c特殊道具#存在购买上限，部分地图无法使用猫咪商人奈落。\n每次可购买的数量上限为：#c超级药水 2700个、发财吧椅子1个、彪鲁纪念币10个#"/>
  </imgdir>
  <imgdir name="5450011">
    <string name="name" value="超值礼包专用商店"/>
    <string name="desc" value="可以在区域地图中使用的超值礼包专用商店。使用后可以进入杂货店。可以购买部分HP、MP恢复药水，以及飞镖、子弹等。但在部分地图中无法使用。"/>
  </imgdir>
  <imgdir name="5450012">
    <string name="name" value="包裹商人妙妙"/>
    <string name="desc" value="使用后可以进入杂货店。可以购买部分HP、MP恢复药水，以及飞镖、子弹等。但在部分地图中无法使用。\n现金物品箱无法移动"/>
  </imgdir>
  <imgdir name="5450013">
    <string name="name" value="[3天]包裹商人妙妙"/>
    <string name="desc" value="使用后，可以进入#c杂货店#。可以购买部分HP、MP恢复药水，补充飞镖、子弹等。可以在所有地图中使用。\n可以在3天内#c无限#使用。"/>
  </imgdir>
  <imgdir name="5451001">
    <string name="name" value="新手转蛋券"/>
    <string name="desc" value="这张新手转蛋券，可以让你使用专属的活动转蛋机。
双击即可出现转蛋机选项，使用即可获得道具。注意！
A、 等级尚未超过71等级之前可以购买及使用该转蛋券。
B、 若等级超过71则无法购买及用该转蛋券。
"/>
  </imgdir>
