  <imgdir name="5680248">
    <string name="name" value="겨울왕국 성형쿠폰"/>
    <string name="desc" value="더블클릭하면 남자는 크리스토프 성형으로, 여자는 엘사 성형으로 변신할 수 있다. 가장 앞쪽의 성형쿠폰부터 차례로 사용된다."/>
  </imgdir>
  <imgdir name="5680249">
    <string name="name" value="겨울왕국 로얄 스타일"/>
    <string name="desc" value="#c쿠폰을 더블클릭하여 운영자# 에게 말을 걸면, #c임의#의 캐시 아이템을 1종 받을 수 있다. 넥슨캐시로 구매한 겨울왕국 로얄 스타일 쿠폰에서 획득된 캐시 아이템은 사용 전 1회 교환할 수 있다. \r\n\r\n캐시샵의 #c쿠폰 아이템을 더블클릭#하면 쿠폰의 내용물을 미리 볼 수 있다. 로얄 스타일 쿠폰은 캐시 인벤토리의 가장 앞쪽에 위치한 쿠폰부터 차례로 사용된다. #c제로 직업군#은 쿠폰 사용 캐릭터의 성별과 상관없이 남자 의상이나 공용 의상 아이템을 획득한다."/>
  </imgdir>
