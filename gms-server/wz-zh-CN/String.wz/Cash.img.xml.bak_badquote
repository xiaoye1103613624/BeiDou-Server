    <string name="desc" value="#c雙擊#使用時，可以獲得#cPINK#勳章(永久)，獲得的勳章不可交易。"/>
    <string name="desc_leftalign" value="#c [PINK 勳章屬性]\n STR : +6\n DEX : +6\n INT : +6\n LUK : +6\n 最大HP : +808\n 最大MP : +808\n 攻擊力 : +3\n 魔力 : +3\n 防禦力 : +808"/>
