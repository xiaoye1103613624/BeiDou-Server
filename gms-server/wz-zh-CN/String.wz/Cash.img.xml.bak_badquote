  </imgdir>
  <imgdir name="5044000">
    <string name="name" value="[1天]快速移动世界地图"/>
    <string name="desc" value="双击道具后出现的世界地图，或在普通的世界地图里，双击想要移动的地区就可以自动移动。包含#c镜世界#的一部分地区限制移动或使用。\n冷却时间: 30分钟"/>
  </imgdir>
  <imgdir name="5044001">
    <string name="name" value="[3天]快速移动世界地图"/>
    <string name="desc" value="双击道具后出现的世界地图，或在普通的世界地图里，双击想要移动的地区就可以自动移动。包含#c镜世界#的一部分地区限制移动或使用。\n冷却时间: 30分钟"/>
  </imgdir>
  <imgdir name="5044002">
    <string name="name" value="[7天]快速移动世界地图"/>
    <string name="desc" value="双击道具后出现的世界地图，或在普通的世界地图里，双击想要移动的地区就可以自动移动。包含#c镜世界#的一部分地区限制移动或使用。\n冷却时间: 30分钟"/>
  </imgdir>
  <imgdir name="5044006">
    <string name="name" value="世界地图传送"/>
