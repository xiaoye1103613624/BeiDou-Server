  <imgdir name="5075000">
    <string name="name" value="冒险岛TV消息"/>
    <string name="desc" value="在冒险岛TV上面显示玩家的形象及 输入的信息，也可以将指定角色通过 荧屏出现在整个区域内。输入的信息 大概持续30秒。该道具使用一次消耗 1个。人物形象将展示在所有频道安 全区的TV上。"/>
  </imgdir>
  <imgdir name="5075001">
